# Balík @react-native-community/datetimepicker (SDK 58) uvádza ako voliteľnú závislosť react-native-windows,
# ktorá vyžaduje staršiu verziu React Native. Appka beží len na iPhone, takže ju nepotrebujeme, ale bez tohto
# nastavenia npm install zlyhá na konflikte závislostí (ERESOLVE).
legacy-peer-deps=true
